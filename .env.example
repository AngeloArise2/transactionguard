# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is already in .gitignore — it will never be committed.
# .env.example (this file) IS committed, so anyone cloning the repo knows what's needed.

# --- Database (must match docker-compose.yml AND backend/src/main/resources/application.yml) ---
POSTGRES_DB=transactionguard
POSTGRES_USER=tg_user
POSTGRES_PASSWORD=tg_pass

# --- JWT signing secret (must match what backend/src/main/resources/application.yml reads) ---
# Generate a real one with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-real-random-secret-at-least-32-characters-long

# --- Redis (defaults are fine for local dev, only change if you altered docker-compose.yml) ---
REDIS_HOST=localhost
REDIS_PORT=6379
