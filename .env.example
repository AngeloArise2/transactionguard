# TransactionGuard environment variables.
#
# Optional for local development — every variable below has a working default
# baked into docker-compose.yml / backend application.yml, so a clean clone runs
# out of the box with no .env at all.
#
# If you DO create a .env (cp .env.example .env), Docker Compose reads it
# automatically for the values below. For the backend to see them when you run
# `mvn spring-boot:run`, export them in your shell instead (e.g. source the file
# or use direnv). .env is gitignored and must never be committed.

# --- Database (used by docker-compose.yml and backend application.yml) ---
POSTGRES_DB=transactionguard
POSTGRES_USER=tg_user
POSTGRES_PASSWORD=tg_pass
# Host port Postgres is exposed on (read by docker-compose.yml and application.yml).
DB_PORT=5432

# --- JWT signing secret (read by backend application.yml) ---
# The backend falls back to a dev-only default if unset; set this for anything
# that isn't a throwaway local demo. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-real-random-secret-at-least-32-characters-long

# --- Redis (used by backend application.yml) ---
REDIS_HOST=localhost
REDIS_PORT=6379
